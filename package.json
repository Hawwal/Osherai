{
  "name": "osher-contracts",
  "version": "1.0.0",
  "description": "Osher AI Celo savings agent baseline",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:celo": "hardhat run scripts/deploy-celo.js --network celo",
    "deploy:vault:alfajores": "hardhat run scripts/deploy-savings-vault.js --network alfajores",
    "deploy:vault:celo": "hardhat run scripts/deploy-savings-vault.js --network celo",
    "verify:celo": "hardhat run scripts/verify-celo.js --network celo",
    "fees:withdraw": "hardhat run scripts/withdraw-fees.js --network celo",
    "build:frontend": "vite build && node scripts/fix-frontend-html.js",
    "build": "npm run build:frontend && hardhat compile"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@vitejs/plugin-react": "^4.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "lucide-react": "^0.487.0",
    "node-fetch": "^2.7.0",
    "openai": "^4.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.28.6",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
